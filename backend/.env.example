DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pausa_massoterapia?schema=public"
PORT=3000
CORS_ORIGINS=http://localhost:5173
# header (protótipo: usuário no cabeçalho x-user-id) ou google (roadmap)
AUTH_MODE=header
GOOGLE_CLIENT_ID=
GOOGLE_WORKSPACE_DOMAIN=

# Valores iniciais das regras de negócio (docs/requisitos.md, RN-01 a RN-11).
# Na primeira inicialização eles são gravados no banco (tabela business_rules).
# Depois disso o banco vence o ambiente: mudar um valor aqui não muda o valor vigente.
# As variáveis continuam obrigatórias e validadas na inicialização.
# Todos aguardam validação do grupo. Durações em minutos.
BOOKING_MIN_NOTICE_MINUTES=60
CANCELLATION_MIN_NOTICE_MINUTES=120
LATE_ARRIVAL_TOLERANCE_MINUTES=10
CHECK_IN_EARLY_MINUTES=15
REMINDER_LEAD_MINUTES=1440
REMINDER_CONFIRMATION_TOLERANCE_MINUTES=720
WAITLIST_ACCEPTANCE_MINUTES=30
SESSION_DURATION_MINUTES=20
SLOT_STEP_MINUTES=20
BOOKING_HORIZON_DAYS=21
MAX_ACTIVE_BOOKINGS_PER_EMPLOYEE=1
# Dias da semana: 1 = segunda ... 7 = domingo
WORK_DAYS=1,2,3,4,5
# Horários no fuso da unidade, formato HH:MM. Sem almoço: LUNCH_START igual a LUNCH_END.
WORK_START=09:00
LUNCH_START=12:00
LUNCH_END=13:00
WORK_END=18:00

NOTIFICATION_WEBHOOK_URL=

ALEXA_SKILL_ID=
ALEXA_USER_MAP=

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
